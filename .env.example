# Public values are safe to expose to the browser. Keep secrets server-only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for application database connections. Use the environment's pooled PostgreSQL URL.
# Keep this database separate from all other environments. Server-only secret.
DATABASE_URL=

# Required only for Prisma CLI migrations. Use the direct, non-pooled URL for the same
# environment/database as DATABASE_URL. Never point this at another environment.
DIRECT_URL=

# Required for authentication at runtime. Server-only secret; use a random 32+ character value.
BETTER_AUTH_SECRET=
# Exact canonical authentication origin. HTTPS is required in production; HTTP loopback in development.
BETTER_AUTH_URL=http://localhost:3000

# Required for Google sign-in at runtime. Server-only credentials.
# Register BETTER_AUTH_URL + /api/auth/callback/google with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
