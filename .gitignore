# Dependencies and package-manager caches.
/node_modules/
/.pnpm-cache/
/.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Test artifacts.
/coverage/
/playwright-report/
/test-results/

# Next.js build output.
/.next/
/.next-e2e/
/.next-integration/
/out/

# Environment files (commit the example only).
.env*
!.env.example
*.local

# OS and editor files.
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Debug logs and local certificates.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pem

# Build output.
/build/

# Deployment output.
.vercel/

# TypeScript-generated files.
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
